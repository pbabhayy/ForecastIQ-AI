# ============================================================
# ForecastIQ AI — Environment Configuration (template)
# Copy this file to ".env" and fill in your values.
# Never commit the real .env file.
# ============================================================

# --- AI Provider Abstraction --------------------------------
# Resolution order is configurable. The system NEVER fully fails:
#   Groq (primary) -> Ollama (secondary) -> Rule-based (always on).
AI_PROVIDER_ORDER=groq,ollama,rule_based

# Groq (PRIMARY) — optional. If absent/unreachable, falls through.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (SECONDARY) — optional local/self-hosted server.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Database -----------------------------------------------
FORECASTIQ_DB_PATH=database/forecastiq.db

# --- Forecasting --------------------------------------------
# Default model strategy for the ForecastManager:
#   auto | prophet | linear_regression | random_forest
FORECAST_DEFAULT_STRATEGY=auto

# --- Application --------------------------------------------
LOG_LEVEL=INFO
APP_ENV=development
